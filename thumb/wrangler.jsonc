{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thumb-on-a-webiste",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/og", "/og/*"]
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "thumb.on-a.website",
      "custom_domain": true
    }
  ]
}
